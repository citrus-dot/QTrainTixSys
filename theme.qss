/* ============================================================
   列车客运售票管理系统 — 全局主题（浅色现代扁平）
   品牌蓝 #2F6FED / 中性灰 / 圆角卡片
   ============================================================ */

QWidget {
    font-family: "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #1B2430;
}

QMainWindow, QDialog {
    background: #F4F6FA;
}

/* 主内容区容器显式浅色背景（覆盖 macOS 深色模式） */
#mainArea, #pages, #trainPage, #queryPageContainer, #centralwidget {
    background: #F4F6FA;
}

/* ---------- 侧边栏 ---------- */
#sidebar, SidebarWidget {
    background: #FFFFFF;
    border-right: 1px solid #E3E7EF;
}
#sidebarBrand {
    font-size: 17px;
    font-weight: 700;
    color: #1B2430;
}
#sidebarSubtitle {
    font-size: 12px;
    color: #98A1B3;
    padding-left: 2px;
}
#sidebarSection {
    font-size: 11px;
    font-weight: 600;
    color: #A8B0BF;
    padding: 10px 4px 4px 4px;
    letter-spacing: 2px;
}
QPushButton[nav="true"] {
    text-align: left;
    padding: 12px 14px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #4A5568;
    font-size: 14px;
}
QPushButton[nav="true"]:hover {
    background: #F0F2F7;
    color: #1B2430;
}
QPushButton[nav="true"]:checked {
    background: #EAF1FE;
    color: #2F6FED;
    font-weight: 600;
}
QPushButton[nav="true"]:pressed {
    background: #DCE8FC;
}
#sidebarInfo {
    background: #F4F6FA;
    border: 1px solid #E3E7EF;
    border-radius: 10px;
}
#sidebarInfoTitle {
    font-size: 12px;
    font-weight: 600;
    color: #1B2430;
}
#sidebarInfoSub {
    font-size: 11px;
    color: #98A1B3;
}
#sidebarVersion {
    font-size: 11px;
    color: #C3CAD8;
    padding: 2px;
}

/* ---------- 顶部栏 ---------- */
#topBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E3E7EF;
}
#pageTitle {
    font-size: 18px;
    font-weight: 600;
    color: #1B2430;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D6DBE6;
    border-radius: 8px;
    padding: 7px 16px;
    color: #1B2430;
    qproperty-iconSize: 18px 18px;
}
QPushButton:hover {
    background: #2F6FED;
    border-color: #2F6FED;
    color: #FFFFFF;
}
QPushButton:pressed {
    background: #2457C4;
    border-color: #2457C4;
    color: #FFFFFF;
}
QPushButton:disabled {
    color: #A8B0BF;
    background: #F4F6FA;
    border-color: #E3E7EF;
}
QPushButton:focus {
    outline: none;
    border-color: #2F6FED;
}

/* 侧边栏导航按钮图标尺寸保持 20px */
QPushButton[nav="true"] {
    qproperty-iconSize: 20px 20px;
}

/* 各按钮图标：默认灰色（代码设置），悬停/按下变白（配合蓝色背景） */
#openButton:hover, #openButton:pressed { qproperty-icon: url(:/icons/file-open-white.svg); }
#saveButton:hover, #saveButton:pressed { qproperty-icon: url(:/icons/file-save-white.svg); }
#addButton:hover, #addButton:pressed { qproperty-icon: url(:/icons/action-add-white.svg); }
#removeButton:hover, #removeButton:pressed { qproperty-icon: url(:/icons/action-delete-white.svg); }
#sellButton:hover, #sellButton:pressed { qproperty-icon: url(:/icons/action-ticket-white.svg); }
#refundButton:hover, #refundButton:pressed { qproperty-icon: url(:/icons/action-refund-white.svg); }
#seatButton:hover, #seatButton:pressed { qproperty-icon: url(:/icons/action-seat-white.svg); }

/* 危险操作按钮（删除） */
QPushButton[danger="true"] {
    background: #E5484D;
    border: none;
    color: #FFFFFF;
    font-weight: 500;
    padding: 8px 20px;
}
QPushButton[danger="true"]:hover {
    background: #D13B40;
}
QPushButton[danger="true"]:pressed {
    background: #B93236;
}

/* 分段切换控件（售票/退票） */
#modeContainer {
    background: #EDF0F5;
    border-radius: 8px;
}
QPushButton[seg="true"] {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 22px;
    color: #667085;
}
QPushButton[seg="true"]:hover {
    color: #1B2430;
}
QPushButton[seg="true"]:checked {
    background: #FFFFFF;
    color: #2F6FED;
    font-weight: 600;
}

/* 座位按钮 */
QPushButton[seat="true"] {
    border: none;
    border-radius: 8px;
    font-weight: 500;
    font-size: 12px;
}
QPushButton[seat="true"][state="empty"] {
    background: #EAF7EF;
    color: #1E7B45;
}
QPushButton[seat="true"][state="empty"]:hover {
    background: #D6EFDF;
}
QPushButton[seat="true"][state="empty"]:pressed {
    background: #C5E7D2;
}
QPushButton[seat="true"][state="occupied"] {
    background: #FDECEC;
    color: #C0392B;
}
QPushButton[seat="true"][state="occupied"]:hover {
    background: #FADDDD;
}
QPushButton[seat="true"][state="occupied"]:pressed {
    background: #F5CFCF;
}
QPushButton[seat="true"][state="selected"] {
    background: #2F6FED;
    color: #FFFFFF;
}
QPushButton[seat="true"][state="selected"]:hover {
    background: #2457C4;
}
QPushButton[seat="true"][state="selected"]:pressed {
    background: #1E4AA8;
}

/* ---------- 输入框 ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: #FFFFFF;
    border: 1px solid #D6DBE6;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #2F6FED;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover {
    border-color: #C3CAD8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border-color: #2F6FED;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background: #F4F6FA;
    color: #A8B0BF;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/icons/chevron-down.png);
    width: 14px;
    height: 14px;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E3E7EF;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #EAF1FE;
    selection-color: #1B2430;
    outline: none;
}

/* ---------- 表格 ---------- */
QTableWidget, QListWidget {
    background: #FFFFFF;
    border: 1px solid #E3E7EF;
    border-radius: 8px;
    gridline-color: #F0F2F7;
    alternate-background-color: #F8FAFD;
    selection-background-color: #EAF1FE;
    selection-color: #1B2430;
    outline: none;
}
QTableWidget::item, QListWidget::item {
    padding: 6px 8px;
}
QTableWidget::item:selected, QListWidget::item:selected {
    background: #EAF1FE;
    color: #1B2430;
}
QHeaderView::section {
    background: #F4F6FA;
    border: none;
    border-bottom: 1px solid #E3E7EF;
    border-right: 1px solid #EDF0F5;
    padding: 8px;
    font-weight: 500;
    color: #667085;
}
QListWidget::item:hover {
    background: #F4F6FA;
}

/* ---------- 卡片 ---------- */
#infoCard {
    background: #FFFFFF;
    border: 1px solid #E3E7EF;
    border-radius: 12px;
}
QLabel[field="caption"] {
    color: #98A1B3;
    font-size: 12px;
}
QLabel[field="value"] {
    color: #1B2430;
    font-size: 14px;
    font-weight: 600;
}
#infoSeparator {
    background: #E3E7EF;
    border: none;
    max-height: 1px;
}
#infoCard QLabel {
    color: #4A5568;
}

/* ---------- 分组标题 ---------- */
#panelTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1B2430;
    padding: 2px 2px 6px 2px;
}

/* ---------- 空状态提示 ---------- */
#emptyFrame {
    background: #FFFFFF;
    border: 1px solid #E3E7EF;
    border-radius: 8px;
}
#emptyHint {
    color: #98A1B3;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* ---------- 座位周边浮窗 ---------- */
#seatMapPopup {
    background: #FFFFFF;
    border: 1px solid #D6DBE6;
    border-radius: 10px;
}
#popupTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1B2430;
}
#popupLegend {
    font-size: 11px;
    color: #667085;
}
#seatCell {
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
}
#seatCell[state="empty"] {
    background: #EAF7EF;
    color: #1E7B45;
}
#seatCell[state="occupied"] {
    background: #FDECEC;
    color: #C0392B;
}
#seatCell[state="selected"] {
    background: #2F6FED;
    color: #FFFFFF;
}

/* ---------- 菜单 ---------- */
QMenuBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E3E7EF;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 5px 12px;
    border-radius: 6px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #EAF1FE;
    color: #1B2430;
}
QMenu {
    background: #FFFFFF;
    border: 1px solid #E3E7EF;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: #EAF1FE;
    color: #1B2430;
}
QMenu::separator {
    height: 1px;
    background: #E3E7EF;
    margin: 4px 8px;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E3E7EF;
    color: #667085;
}
QStatusBar::item {
    border: none;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D3D9E4;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #B9C2D2;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #D3D9E4;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #B9C2D2;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 提示与消息框 ---------- */
QToolTip {
    background: #1B2430;
    color: #FFFFFF;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
}
QMessageBox {
    background: #FFFFFF;
}
QMessageBox QLabel {
    color: #1B2430;
}

/* ---------- 对话框按钮 ---------- */
QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* ---------- 分隔条 ---------- */
QSplitter::handle {
    background: transparent;
    width: 6px;
}
QSplitter::handle:hover {
    background: #E3E7EF;
    border-radius: 3px;
}
